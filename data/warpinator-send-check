#!/bin/sh
# Nemo runs this on every right-click on a file, so it must be fast:
# gdbus answers in milliseconds, starting Python takes about a second on a slow CPU.

# Don't start Warpinator just to answer this.
gdbus call --session --timeout 2 --dest org.freedesktop.DBus \
    --object-path /org/freedesktop/DBus \
    --method org.freedesktop.DBus.NameHasOwner org.x.Warpinator 2>/dev/null \
    | grep -q true || exit 1

# Show "Send via Warpinator" only when there is somebody to send to.
gdbus call --session --timeout 2 --dest org.x.Warpinator \
    --object-path /org/x/Warpinator \
    --method org.x.Warpinator.ListRemotes 2>/dev/null \
    | grep -q '\[{'
