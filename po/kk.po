#. DO NOT TRANSLATE Warpinator
#: data/org.x.Warpinator.appdata.xml.in.in:10
msgid "Warpinator"
msgstr "Warpinator"

#: data/org.x.Warpinator.appdata.xml.in.in:11
msgid "Share files on your network"
msgstr "Желіде файлдармен бөлісу"

#: data/org.x.Warpinator.appdata.xml.in.in:13
msgid ""
"Warpinator allows you to easily connect multiple computers on a local area "
"network and exchange files quickly and securely."
msgstr ""
"Warpinator жергілікті желідегі бірнеше компьютерді оңай қосуға және "
"файлдарды тез әрі қауіпсіз алмасуға мүмкіндік береді."

#: data/org.x.Warpinator.appdata.xml.in.in:14
msgid "Features:"
msgstr "Мүмкіндіктері:"

#: data/org.x.Warpinator.appdata.xml.in.in:16
msgid "An easy-to-use graphical interface."
msgstr "Пайдалануға оңай графикалық интерфейс."

#: data/org.x.Warpinator.appdata.xml.in.in:17
msgid "Automatic discovery of devices on your network."
msgstr "Желідегі құрылғыларды автоматты түрде анықтау."

#: data/org.x.Warpinator.appdata.xml.in.in:18
msgid "Fully secure and encrypted connections between devices."
msgstr "Құрылғылар арасындағы толық қауіпсіз және шифрланған қосылымдар."

#: data/org.x.Warpinator.appdata.xml.in.in:19
msgid "Multiple simultaneous transfers."
msgstr "Бірнеше бір мезгілдегі тасымалдаулар."

#: data/org.x.Warpinator.appdata.xml.in.in:20
msgid "Optional data compression."
msgstr "Міндетті емес деректерді сығу."

#: data/org.x.Warpinator.appdata.xml.in.in:21
msgid ""
"Grouping of devices using a shared key, with multiple groups possible on the "
"same network."
msgstr ""
"Ортақ кілтті пайдаланып құрылғыларды топтастыру, бір желіде бірнеше топ "
"болуы мүмкін."

#: data/org.x.Warpinator.appdata.xml.in.in:22
msgid "Manual connections for restricted network environments."
msgstr "Шектеулі желілік орталар үшін қолмен қосылу."

#: data/org.x.Warpinator.appdata.xml.in.in:45
msgid "The main view showing connected devices and their status"
msgstr "Қосылған құрылғыларды және олардың күйін көрсететін негізгі көрініс"

#: data/org.x.Warpinator.appdata.xml.in.in:49
msgid ""
"Individual connection page showing individual incoming or outgoing transfers"
msgstr "Жеке кіріс немесе шығыс тасымалдауларын көрсететін жеке қосылым беті"

#: data/org.x.Warpinator.appdata.xml.in.in:53
msgid "Manual connection dialog"
msgstr "Қолмен қосылу сұхбат терезесі"
