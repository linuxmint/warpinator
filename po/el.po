#: resources/main-window.ui:962
msgid "Android"
msgstr "Android"

#: resources/main-window.ui:978 resources/main-window.ui:993
msgid "Windows"
msgstr "Windows"

#: resources/main-window.ui:1067
msgid "Initializing, please wait..."
msgstr "Εκκίνηση, περιμένετε..."

#: resources/main-window.ui:1125
msgid "Something went wrong"
msgstr "Κάτι πήγε στραβά"

#: resources/main-window.ui:1200
msgid "Invalid save location"
msgstr "Μη έγκυρη τοποθεσία αποθήκευσης"

#: resources/main-window.ui:1237
msgid ""
"This folder is either inaccessible or forbidden to save files to.  Please "
"select a new location in Preferences and ensure that it is accessible."
msgstr ""
"Αυτός ο φάκελος είτε δεν είναι προσβάσιμος είτε έχει εσφαλμένα δικαιώματα. "
"Επιλέξτε μια νέα τοποθεσία από τις προτιμήσεις και βεβαιωθείτε ότι είναι "
"προσβάσιμη."

#: resources/main-window.ui:1309
msgid "Searching for other computers"
msgstr "Αναζήτηση για άλλους υπολογιστές"

#: resources/main-window.ui:1368
msgid "Shutting down..."
msgstr "Τερματισμός..."

#: resources/main-window.ui:1440
msgid "Restart required"
msgstr "Απαιτείται επανεκκίνηση"

#: resources/main-window.ui:1457
msgid "Warpinator needs to restart before the new save directory can be used"
msgstr ""
"Το Warpinator πρέπει να κάνει επανεκκίνηση για να μπορέσει να χρησιμοποιηθεί "
"ο νέος κατάλογος αποθήκευσης"

#: resources/main-window.ui:1467
msgid "Restart"
msgstr "Επανεκκίνηση"

#: resources/main-window.ui:1537
msgid "Disk Full"
msgstr "Πλήρης δίσκος"

#: resources/main-window.ui:1574
msgid ""
"There is insufficient space available in the save location. You need to "
"delete some files, decrease the minimum free space in preferences or choose "
"a new location."
msgstr ""
"Ο διαθέσιμος χώρος στην τοποθεσία αποθήκευσης δεν επαρκεί. Θα χρειαστεί να "
"διαγράψετε μερικά αρχεία, να μειώσετε το ελάχιστο όριο ελεύθερου χώρου από "
"τις προτιμήσεις ή να επιλέξετε μια άλλη τοποθεσία."

#: resources/main-window.ui:1591
msgid "Empty trash"
msgstr "Άδειασμα απορριμμάτων"

#: resources/main-window.ui:1605 src/warpinator.py:610 src/warpinator.py:1747
msgid "Open save folder"
msgstr "Άνοιγμα φακέλου αποθήκευσης"

#: resources/main-window.ui:1618
msgid "Examine disk usage"
msgstr "Έλεγχος χρήσης δίσκου"

